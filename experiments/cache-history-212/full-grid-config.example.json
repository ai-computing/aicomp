{
  "servers": [
    [
      "/path/to/python",
      "/path/to/runtime/opt_prime/examples/pd/serve_batched.py",
      "--model",
      "/path/to/frozen/model",
      "--device",
      "cuda:0",
      "--dtype",
      "bfloat16",
      "--slots",
      "4",
      "--max-context",
      "9216",
      "--max-output",
      "128",
      "--kv",
      "paged",
      "--page-size",
      "256",
      "--chunk",
      "256",
      "--port",
      "{port}"
    ]
  ],
  "metadata": {
    "physical_gpus": 1,
    "physical_rngd": 0,
    "physical_atom": 0,
    "slots_per_decoder": 4,
    "producer_cache": false,
    "decoder_cache": false,
    "producer_chunk": 256,
    "local_chunk": 256,
    "context": 9216
  }
}
